{
  "name": "dataconv-client-sdk-ts",
  "version": "0.4.3",
  "description": "DataConv TypeScript SDK for tenant activation, research mapping and conversion APIs.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "dataconv-client": "dist/cli.js",
    "dataconv": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "DATACONV_BASE_URL=http://localhost:8080 jest",
    "test:local": "DATACONV_BASE_URL=http://localhost:8080 jest",
    "lint": "eslint src/**/*.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "dataconv",
    "sdk",
    "didcomm",
    "preconversion",
    "excel",
    "csv",
    "typescript",
    "react",
    "react-native"
  ],
  "author": "Antifraud Services Inc.",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "fflate": "^0.8.3",
    "gdc-common-utils-ts": "^1.2.0"
  }
}
